{
  "name": "lunch-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "package:tv": "node scripts/package-tizen.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs",
    "format": "prettier --write src server shared test public index.html README.md package.json",
    "format:check": "prettier --check src server shared test public index.html README.md package.json"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "prettier": "^3.9.9",
    "vite": "^7.1.7"
  }
}
